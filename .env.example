APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Set to the smallest context/output limits among configured live models.
RESEARCH_CONTEXT_WINDOW=32768
RESEARCH_MAX_OUTPUT_TOKENS=2048
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://workspace:workspace@127.0.0.1:5432/workspace
REDIS_URL=redis://localhost:6379/0

# A provider is registered only when its API key, model, and base URL are configured.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=

# Live research tools. Without BRAVE_SEARCH_API_KEY the Research Agent uses deterministic mocks.
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=

# V0.2 retrieval: mock is a local lexical demo, HTTP opts into a live provider.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Must match the configured provider's output dimensions.
EMBEDDING_DIMENSIONS=256
